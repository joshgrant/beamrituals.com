{% assign articles = site.articles | where_exp: "article", "article.link" | sort: "date" | reverse %}
{ "articles": [
{% for article in articles limit: include.limit %}
	{ "date": {{ article.date | date: "%Y-%m-%d" | jsonify }}, "url": {{ article.link | jsonify }} }{% unless forloop.last %},{% endunless %}
{% endfor %}
] }